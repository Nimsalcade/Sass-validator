    "@trpc/server": "^11.7.1",
    "@types/next-auth": "^3.13.0",
    "@types/redis": "^4.0.10",
    "autoprefixer": "^10.4.21",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "next": "^16.0.1",
    "next-auth": "^4.24.13",
    "playwright": "^1.48.2",
    "prisma": "^6.19.0",
    "react": "^18.3.1",
