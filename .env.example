# Server Configuration
PORT=3000
NODE_ENV=development

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/scraping_guardrails"

# Scraping Configuration
DEFAULT_USER_AGENT="ScrapingGuardrails/1.0 (+https://example.com/bot)"
REQUEST_TIMEOUT=30000
MAX_REDIRECTS=5

# Rate Limiting Configuration
DEFAULT_RATE_LIMIT_REQUESTS=10
DEFAULT_RATE_LIMIT_WINDOW=60000
BACKOFF_INITIAL_DELAY=1000
BACKOFF_MAX_DELAY=60000
BACKOFF_MULTIPLIER=2

# Caching Configuration
CACHE_TTL=3600
MAX_CACHE_SIZE=10000

# Global Throttling
GLOBAL_MAX_REQUESTS_PER_SECOND=100
GLOBAL_MAX_CONCURRENT_REQUESTS=50

# Allowlist Configuration
ALLOWED_DOMAINS="example.com,test.com,api.example.com"
BLOCKED_DOMAINS="spam.com,malicious.com"

# PII Filtering
ENABLE_PII_FILTERING=true
PII_CONFIDENCE_THRESHOLD=0.7

# Audit Logging
AUDIT_LOG_RETENTION_DAYS=90