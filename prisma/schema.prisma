// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Example User model with NextAuth integration
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  projects      Project[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Add your custom fields here
  // For example:
  // role          Role      @default(USER)
  // profile       Profile?
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Example Document model with pgvector support
model Document {
  id        Int      @id @default(autoincrement())
  content   String   @db.Text
  embedding Float[]  // Vector stored as array for pgvector
  metadata  Json?
  title     String?
  url       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

// Example Search Result model
model SearchResult {
  id          Int      @id @default(autoincrement())
  query       String
  title       String
  url         String   @unique
  content     String   @db.Text
  source      String
  relevance   Float?
  createdAt   DateTime @default(now())

  @@index([query])
  @@index([source])
}

// Example API Usage model for tracking
model ApiUsage {
  id        Int      @id @default(autoincrement())
  userId    String?
  service   String   // "openai", "tavily", "browserless", etc.
  endpoint  String
  cost      Float?
  tokens    Int?
  status    String   // "success", "error"
  error     String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([service])
  @@index([createdAt])
}

// Example enums
enum Role {
  USER
  ADMIN
  MODERATOR
}

// Project model for organizing work
model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  status      String   @default("ACTIVE") // ACTIVE, INACTIVE, ARCHIVED
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  research    Research[]
  files       File[]
  experiments Experiment[]
  assets      Asset[]

  @@index([userId])
  @@index([status])
}

// Research content model
model Research {
  id          String   @id @default(cuid())
  title       String
  content     String   @db.Text
  summary     String?
  sources     String[] // Array of source URLs/references
  tags        String[] // Array of tags for categorization
  projectId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([tags])
}

// File management model
model File {
  id        String   @id @default(cuid())
  name      String
  size      Int
  type      String   // MIME type
  path      String   // Storage path/URL
  projectId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

// Experiment tracking model
model Experiment {
  id          String            @id @default(cuid())
  name        String
  description String?
  hypothesis  String?
  parameters  Json?             // Experiment parameters and configuration
  status      String            @default("DRAFT") // DRAFT, RUNNING, COMPLETED, FAILED
  projectId   String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  project     Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  results     ExperimentResult[]
  scores      Score[]

  @@index([projectId])
  @@index([status])
}

// Experiment results model
model ExperimentResult {
  id           String   @id @default(cuid())
  data         Json     // Result data
  metrics      Json?    // Performance metrics
  notes        String?
  experimentId String
  createdAt    DateTime @default(now())

  experiment   Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)

  @@index([experimentId])
}

// Scoring model
model Score {
  id           String   @id @default(cuid())
  name         String
  description  String?
  value        Float
  maxValue     Float
  percentage   Float    // Calculated field: (value / maxValue) * 100
  category     String?  // For grouping scores
  weights      Json?    // Weight configuration
  experimentId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  experiment   Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)

  @@index([experimentId])
  @@index([category])
}

// Asset management model
model Asset {
  id          String   @id @default(cuid())
  name        String
  type        String   // LANDING_PAGE, EMAIL_SEQUENCE, SOCIAL_MEDIA, BLOG_POST, OTHER
  content     String?  @db.Text
  metadata    Json?    // Additional metadata, generation info, etc.
  status      String   @default("DRAFT") // DRAFT, PUBLISHED, ARCHIVED
  projectId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([type])
  @@index([status])
}

// You can add more models as needed for your specific application
// Examples:
// - Blog posts with embeddings for search
// - User preferences and settings
// - Analytics and tracking data
// - File uploads and S3 references
